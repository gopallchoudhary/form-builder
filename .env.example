# Copy to .env and fill in. `setup.sh` symlinks this file into every
# apps/* and packages/* directory so `dotenv --` picks it up from the
# workspace root as well as from each package.

# ── Runtime ────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# A dedicated database for service integration tests. Must not be DATABASE_URL.
# Created and migrated automatically. Tests are skipped when this is unset.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/streamyst_test

# ── Auth ───────────────────────────────────────────────────────────────────────
# Must be at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── API server ─────────────────────────────────────────────────────────────────
PORT=8000
# Public origin of this API, used to build the OpenAPI baseUrl.
API_BASE_URL=http://localhost:8000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Number of proxy hops to trust when deriving the client IP (0 = no proxy).
# Set to 1 when running behind a single reverse proxy / load balancer.
TRUST_PROXY=0

# ── Cookies ────────────────────────────────────────────────────────────────────
# Must be true in production (HTTPS only). `none` also requires Secure.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAME_SITE=lax
# Optional shared parent domain, e.g. .example.com. Leave empty for host-only.
COOKIE_DOMAIN=

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Logging ────────────────────────────────────────────────────────────────────
# error | info | debug. Defaults to debug in development, error otherwise.
LOGGER_LEVEL=

# ── Web app (public, must be prefixed NEXT_PUBLIC_) ────────────────────────────
# Used for share links and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# tRPC endpoint the browser talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
# Where the web app's *server* reaches the API, for server components and server-side
# auth checks. Optional — falls back to NEXT_PUBLIC_API_URL. Set it when the server
# should use an internal address rather than the public one.
API_URL=
