# Copy to /opt/formora/.env, fill every blank, then `chmod 600 /opt/formora/.env`.
# Never commit the filled file.

NODE_ENV=production
PORT=8000

# Public API origin, used for the generated OpenAPI document.
API_BASE_URL=https://formorabackend.gopalchoudhary.dev

# Browser origins allowed to call the API and open the Socket.IO connection.
# Must be the exact web origin, with no trailing slash.
CORS_ORIGINS=https://formora.gopalchoudhary.dev

# Traefik is one reverse-proxy hop in front of the API.
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Needed so the Next.js server on the web subdomain can read the auth cookie.
# Leave empty if the web app is not under gopalchoudhary.dev.
COOKIE_DOMAIN=.gopalchoudhary.dev

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The host is the compose service name; the database is not published to the host.
DATABASE_URL=postgresql://formora:CHANGE_ME@postgres:5432/formora
POSTGRES_USER=formora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=formora

# Let's Encrypt registration email.
ACME_EMAIL=

LOGGER_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# CI sets this to the commit SHA for each deploy. Latest is only a manual fallback.
IMAGE_TAG=latest
